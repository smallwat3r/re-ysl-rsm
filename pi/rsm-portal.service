[Unit]
Description=Rouge Sur Mesure captive portal redirect (hotspot)
# no After=network.target: it binds every interface, so it can start early
# and be ready when the hotspot (hostapd.service) comes up

[Service]
# pi/setup.sh installs this with User and the paths filled in.
User=pi
WorkingDirectory=/home/pi/re-ysl-rsm
ExecStart=/usr/bin/python3 pi/portal.py http://10.42.0.1:8765/ 80 pi/portal.pem
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
