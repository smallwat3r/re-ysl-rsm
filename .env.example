# Copy to .env and fill in. Loaded by the Makefile, pi/setup.sh and rsm.service,
# so keep it to plain KEY=value lines: no quotes, no spaces. .env is gitignored.

# The device's BLE address (find it with `make scan`). Required to connect.
RSM_ADDRESS=AA:BB:CC:DD:EE:FF

# Optional: serve the control page to the network (home LAN or the Pi's
# hotspot), reachable at http://<hostname>.local:8765 or the Pi's IP. Unset =
# this machine only. See README.
# RSM_LAN=1

# Optional: Wi-Fi hotspot for a standalone Pi (see pi/setup.sh, needs RSM_LAN=1).
# The phone joins this network and opens http://10.42.0.1:8765.
# RSM_HOTSPOT_SSID=rsm
# RSM_HOTSPOT_PASSWORD=choose-8-or-more-characters

# Optional: where `make deploy` pushes the checkout (see pi/deploy.sh). Over
# the hotspot that is pi@10.42.0.1, on a cable the lease the laptop handed out.
# RSM_PI=pi@10.42.0.1
